---
// Enquiry form for the Apply and Contact pages, sent through Web3Forms (the service the old site used).
// Works without JavaScript: the browser posts to Web3Forms, which redirects to /thank-you.
// With JavaScript, it submits in place and shows the confirmation without leaving the page.
import { Icon } from 'astro-icon/components';
import { business } from '~/data/business';
import { industries } from '~/data/industries';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  variant: 'apply' | 'contact';
  subject: string;
  fromName: string;
  button: string;
}

const { variant, subject, fromName, button } = Astro.props;
const id = `lf-${variant}`;
const redirect = new URL(getPermalink('/thank-you'), 'https://lighterfinance.com.au').toString();

const field =
  'block w-full rounded-lg border border-line bg-white px-4 py-3 text-base text-heading placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30';
const label = 'mb-1.5 block text-sm font-medium text-heading';
---

<div data-lead-form>
  <form action="https://api.web3forms.com/submit" method="POST" class="grid gap-5" novalidate={false}>
    <input type="hidden" name="access_key" value={business.web3formsKey} />
    <input type="hidden" name="subject" value={subject} />
    <input type="hidden" name="from_name" value={fromName} />
    <input type="hidden" name="redirect" value={redirect} />
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

    {
      variant === 'apply' ? (
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for={`${id}-name`} class={label}>
              Full name
            </label>
            <input id={`${id}-name`} name="full_name" type="text" autocomplete="name" required class={field} />
          </div>
          <div>
            <label for={`${id}-business`} class={label}>
              Business name
            </label>
            <input
              id={`${id}-business`}
              name="business_name"
              type="text"
              autocomplete="organization"
              required
              class={field}
            />
          </div>
        </div>
      ) : (
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for={`${id}-first`} class={label}>
              First name
            </label>
            <input id={`${id}-first`} name="first_name" type="text" autocomplete="given-name" required class={field} />
          </div>
          <div>
            <label for={`${id}-last`} class={label}>
              Last name
            </label>
            <input id={`${id}-last`} name="last_name" type="text" autocomplete="family-name" required class={field} />
          </div>
        </div>
      )
    }

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for={`${id}-email`} class={label}>Email</label>
        <input id={`${id}-email`} name="email" type="email" autocomplete="email" required class={field} />
      </div>
      <div>
        <label for={`${id}-phone`} class={label}>Phone</label>
        <input
          id={`${id}-phone`}
          name="phone"
          type="tel"
          autocomplete="tel"
          placeholder="04XX XXX XXX"
          required
          class={field}
        />
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for={`${id}-industry`} class={label}>Industry</label>
        <select id={`${id}-industry`} name="industry" required class={field}>
          <option value="">Select your industry</option>
          {industries.map((industry) => <option>{industry.name}</option>)}
          <option>Other</option>
        </select>
      </div>
      <div>
        <label for={`${id}-amount`} class={label}
          >{variant === 'apply' ? 'Loan amount' : 'Approximate loan amount'}</label
        >
        <input
          id={`${id}-amount`}
          name="loan_amount"
          type="text"
          inputmode="numeric"
          placeholder="e.g. $75,000"
          class={field}
        />
      </div>
    </div>

    {
      variant === 'apply' && (
        <div>
          <label for={`${id}-turnover`} class={label}>
            Annual turnover
          </label>
          <input
            id={`${id}-turnover`}
            name="annual_turnover"
            type="text"
            inputmode="numeric"
            placeholder="e.g. $500,000"
            class={field}
          />
        </div>
      )
    }

    <div>
      <label for={`${id}-message`} class={label}>
        {variant === 'apply' ? 'Anything else we should know?' : 'Tell us about your situation'}{' '}
        <span class="font-normal text-muted">(optional)</span>
      </label>
      <textarea id={`${id}-message`} name="message" rows="4" placeholder="What are you looking to fund?" class={field}
      ></textarea>
    </div>

    <div>
      <button type="submit" class="btn-primary w-full">
        <span data-label>{button}</span>
      </button>
      <p class="mt-3 text-center text-sm text-muted">
        No commitment and no credit check at this stage. See our <a
          class="underline hover:text-primary"
          href={getPermalink('/privacy')}>privacy policy</a
        >.
      </p>
      <p data-error class="mt-3 hidden rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
        Your details didn’t send. Check your connection and try again, or call us on {business.phone}.
      </p>
    </div>
  </form>

  <div data-success class="hidden py-10 text-center" role="status" tabindex="-1">
    <Icon name="tabler:circle-check" class="mx-auto h-14 w-14 text-primary" />
    <h2 class="mt-4 font-heading text-2xl font-semibold text-heading">
      {variant === 'apply' ? 'Application received' : 'Message received'}
    </h2>
    <p class="mx-auto mt-2 max-w-sm text-muted">
      Thanks. One of our brokers will review your details and be in touch, usually within a few hours.
    </p>
  </div>
</div>

<script>
  function initLeadForms() {
    document.querySelectorAll<HTMLElement>('[data-lead-form]').forEach((wrap) => {
      const form = wrap.querySelector('form');
      if (!form || form.dataset.ready) return;
      form.dataset.ready = 'true';
      const label = form.querySelector<HTMLElement>('[data-label]');
      const error = form.querySelector<HTMLElement>('[data-error]');
      const success = wrap.querySelector<HTMLElement>('[data-success]');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const original = label?.textContent;
        if (label) label.textContent = 'Sending…';
        if (button) button.disabled = true;
        error?.classList.add('hidden');
        try {
          const data = new FormData(form);
          data.delete('redirect');
          const response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: data,
          });
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || 'Submission failed');
          form.classList.add('hidden');
          success?.classList.remove('hidden');
          success?.focus();
        } catch {
          error?.classList.remove('hidden');
          if (label && original) label.textContent = original;
          if (button) button.disabled = false;
        }
      });
    });
  }
  document.addEventListener('astro:page-load', initLeadForms);
</script>
