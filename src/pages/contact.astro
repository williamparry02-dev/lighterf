---
import Layout from '~/layouts/PageLayout.astro';
import LeadForm from '~/components/LeadForm.astro';
import { Icon } from 'astro-icon/components';
import { business } from '~/data/business';

const metadata = {
  title: 'Contact us',
  description:
    'Talk to a Lighter Finance broker. Send an enquiry, call 0478 022 067 or email us, and we’ll be in touch within a few hours. No obligation, no hard sell.',
};

const details = [
  { icon: 'tabler:phone', title: 'Phone', text: business.phone, href: business.phoneHref },
  { icon: 'tabler:mail', title: 'Email', text: business.email, href: `mailto:${business.email}` },
  { icon: 'tabler:clock', title: 'Response time', text: `Within a few hours. ${business.hours}.` },
];
---

<Layout metadata={metadata}>
  <section class="relative not-prose">
    <div class="absolute inset-0 bg-sky" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-20">
      <div class="max-w-3xl">
        <h1 class="font-heading text-4xl font-bold tracking-tight text-heading md:text-5xl">
          Let’s find the right finance for your business
        </h1>
        <p class="mt-4 text-lg text-muted">
          Fill in the form and one of our brokers will be in touch within a few hours. No obligation, no hard sell, just
          straightforward advice.
        </p>
      </div>
      <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <div class="rounded-2xl bg-white p-6 shadow-xl shadow-navy/5 ring-1 ring-line sm:p-10">
            <h2 class="mb-6 font-heading text-2xl font-semibold text-heading">Send us a message</h2>
            <LeadForm
              variant="contact"
              subject="New Enquiry — Lighter Finance"
              fromName="Lighter Finance Contact Page"
              button="Send enquiry"
            />
          </div>
        </div>
        <aside class="lg:col-span-5">
          <h2 class="font-heading text-2xl font-semibold text-heading">Contact details</h2>
          <ul class="mt-6 space-y-6">
            {
              details.map(({ icon, title, text, href }) => (
                <li class="flex gap-4">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-primary shadow-sm">
                    <Icon name={icon} class="h-6 w-6" />
                  </span>
                  <span>
                    <span class="block text-sm text-muted">{title}</span>
                    {href ? (
                      <a class="block break-all font-semibold text-heading hover:text-primary" href={href}>
                        {text}
                      </a>
                    ) : (
                      <span class="block font-semibold text-heading">{text}</span>
                    )}
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="mt-8 rounded-xl bg-white p-5 text-muted shadow-sm">
            60+ lenders on our panel. We run a single soft enquiry to explore your options without affecting your credit
            score.
          </p>
        </aside>
      </div>
    </div>
  </section>
</Layout>
